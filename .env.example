# --- LLM (Ollama, API compatible con OpenAI) ---
LLM_BASE_URL=http://localhost:11434/v1
LLM_MODEL=qwen3.8:27b-mlx
# Ollama no requiere API key; se envía un valor de relleno.
LLM_API_KEY=ollama
# "none" desactiva el razonamiento: primer token en ~1 s (recomendado para chat).
# Vacío = comportamiento por defecto del modelo (Qwen razona primero: ~20-30 s más, se ve "Pensando…").
LLM_REASONING_EFFORT=none
LLM_TEMPERATURE=0.3

# --- Embeddings para RAG (si se deja vacío usa LLM_BASE_URL) ---
EMBED_BASE_URL=
EMBED_MODEL=qwen3-embedding:0.6b

# --- Servicio de generación de documentos ---
# Mientras el servicio real no esté listo, apunta al mock (scripts/dev.sh lo levanta en :8701)
DOC_SERVICE_URL=http://127.0.0.1:8701
# Token opcional (Authorization: Bearer ...). Déjalo vacío para el mock.
DOC_SERVICE_TOKEN=

# --- RAG ---
RAG_TOP_K=6

# --- Dictámenes técnicos (botón 📎: oficio -> datos con el LLM -> DOCX). Ver README ---
# Sin autenticación: actívalos solo en instalaciones internas (compose.yaml los apaga).
DICTAMEN_ENABLED=true
DICTAMEN_MAX_UPLOAD_MB=15
DICTAMEN_MAX_PAGES=4
# Vacío = LLM_MODEL (debe aceptar imágenes para fotos y PDF escaneados).
DICTAMEN_EXTRACT_MODEL=
DICTAMEN_EXTRACT_TIMEOUT_S=240
